rw_dir_file(hal_fingerprint_default,sysfs_lge_touch)

allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default self:netlink_socket { read write bind create };

binder_call(hal_fingerprint_default, hal_powerhint_default)
allow hal_fingerprint_default hal_lge_powerhint_hwservice:hwservice_manager find;

allow hal_fingerprint_default mnt_vendor_file:dir search;
