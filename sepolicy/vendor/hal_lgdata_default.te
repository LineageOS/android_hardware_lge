type hal_lgdata_default, domain;
hal_server_domain(hal_lgdata_default, hal_lgdata)

type hal_lgdata_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lgdata_default)

# libqmi_cci needs socket metadata and transport operations to initialize the
# modem QoS clients. Creation alone leaves all bearer subscriptions inactive.
allow hal_lgdata_default self:qipcrtr_socket { create getattr read write setopt };
