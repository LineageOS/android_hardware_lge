binder_call(hal_nfc_default, hal_secure_element_default)

add_hwservice(hal_nfc_default, hal_nfc_hwservice)

allow hal_nfc_default nfc_device:chr_file rw_file_perms;

#Allow access to firmware
allow hal_nfc_default mnt_vendor_file:dir search;
r_dir_file(hal_nfc_default, firmware_file)
r_dir_file(hal_nfc_default, persist_lg_data_file)

# Allow NFC HAL to find NFC hwservice
allow hal_nfc_default hal_nfc_hwservice:hwservice_manager find;
