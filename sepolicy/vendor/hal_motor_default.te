type hal_motor_default, domain;
type hal_motor_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_motor_default)
hwbinder_use(hal_motor_default)
get_prop(hal_motor_default, hwservicemanager_prop)

add_hwservice(hal_motor_default, hal_motor_hwservice)

allow hal_motor_default motor_device:chr_file { getattr open read write ioctl };

# Device context supplies orientation and free-fall events used by the motor HAL.
hal_client_domain(hal_motor_default, hal_sensors)

# CameraHelper controls the pop-up motor and receives its status callback.
binder_call(system_app, hal_motor_default)
binder_call(hal_motor_default, system_app)
allow system_app hal_motor_hwservice:hwservice_manager find;

# The stock camera provider may also control the motor directly.
binder_call(hal_camera_default, hal_motor_default)
allow hal_camera_default hal_motor_hwservice:hwservice_manager find;
