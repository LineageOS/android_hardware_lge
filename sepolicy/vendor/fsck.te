allow fsck { persdata_abt_block_device
             power_block_device
             sns_block_device
             drm_block_device }:file rw_file_perms;

allow fsck { drm_block_device
             mpt_block_device
             persdata_abt_block_device
             power_block_device
             qni_block_device
             sns_block_device }:blk_file rw_file_perms;

allow fsck self:capability kill;
