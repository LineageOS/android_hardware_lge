soong_config_module_type {
    name: "lge_amplifier_config",
    module_type: "cc_library",
    config_namespace: "lgeAmplifier",
    bool_variables: [
        "HIFI_QUAD_DAC",
        "EXT_AMPLIFIER",
    ],
    properties: [
        "cflags",
        "include_dirs",
    ],
}

lge_amplifier_config {
    name: "lge_amplifier",

    srcs: ["amplifier.c"],

    soong_config_variables: {
        HIFI_QUAD_DAC: {
            cflags: ["-DSUPPORT_HIFI_QUAD_DAC"],
            include_dirs: ["$(TARGET_DAC_PLUGIN_INCLUDE_DIR)"],
        },
        EXT_AMPLIFIER: {
            cflags: ["-DSUPPORT_EXT_AMPLIFIER"],
        },
    },
}

cc_library_shared {
    name: "audio_amplifier.lge",
    relative_install_path: "hw",
    vendor: true,
    owner: "qti",

    srcs: [
        "amplifier.c",
    ],

    local_include_dirs: ["include"],

    include_dirs: [
        "external/tinyalsa/include",
        "external/tinycompress/include",
        "system/media/audio_route/include",
        "system/media/audio_utils/include",
    ] + select(soong_config_variable("ANDROID", "target_board_platform"), {
        "kona": [
            "hardware/qcom-caf/sm8250/audio/hal",
            "hardware/qcom-caf/sm8250/audio/hal/audio_extn",
            "hardware/qcom-caf/sm8250/audio/hal/msm8974",
        ],
        default: [],
    }),

    header_libs: [
        "libhardware_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libtinyalsa",
    ],
}
