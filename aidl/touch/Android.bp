cc_binary {
    name: "vendor.lineage.touch-service.lge",
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.touch-service.lge.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.lge.xml"],
    cflags: select(soong_config_variable("LGE_TOUCH", "LEGACY_TOUCHSCREEN_INTERFACE_HEADERS"), {
        any @ flag_val: ["-DLEGACY_TOUCHSCREEN_INTERFACE"],
        default: [],
    }),
    include_dirs: select(soong_config_variable("LGE_TOUCH", "LEGACY_TOUCHSCREEN_INTERFACE_HEADERS"), {
        any @ flag_val: [flag_val],
        default: [],
    }),
    srcs: [
        "GloveMode.cpp",
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
    vendor: true,
}
