cc_binary {
    name: "vendor.lineage.touch-service.lge",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.touch-service.lge.rc"],
    vintf_fragments: select(soong_config_variable("touch_lge", "enable_tg"), {
        "true": ["vendor.lineage.touch-service.lge-tg.xml"],
        default: [],
    }),
    cflags: select(soong_config_variable("touch_lge", "enable_tg"), {
         "true": ["-DENABLE_TG=true"],
        default: ["-DENABLE_TG=false"],
    }),
    srcs: [
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}
