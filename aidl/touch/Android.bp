_default_gesture_available_path = "/sys/devices/virtual/input/lge_touch/swipe_available"
_default_gesture_enable_path = "/sys/devices/virtual/input/lge_touch/swipe_enable"
_default_glove_mode_path = "/sys/devices/virtual/input/lge_touch/film_status"

cc_binary {
    name: "vendor.lineage.touch-service.lge",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.touch-service.lge.rc"],

    vintf_fragments: select(soong_config_variable("touch_lge", "enable_tg"), {
        "false": [],
        "true": ["vendor.lineage.touch-service.lge-tg.xml"],
        default: ["vendor.lineage.touch-service.lge-tg.xml"],
    }) + select(soong_config_variable("touch_lge", "enable_gm"), {
        "false": [],
        "true": ["vendor.lineage.touch-service.lge-gm.xml"],
        default: ["vendor.lineage.touch-service.lge-gm.xml"],
    }),

    cflags: select(soong_config_variable("touch_lge", "enable_tg"), {
        "false": ["-DENABLE_TG=false"],
        "true": [
            "-DENABLE_TG=true",
            "-DGESTURE_AVAILABLE_PATH=\"$(soong_config_variable touch_lge gesture_available_path ?: _default_gesture_available_path)\"",
            "-DGESTURE_ENABLE_PATH=\"$(soong_config_variable touch_lge gesture_enable_path ?: _default_gesture_enable_path)\"",
        ],
        default: [
            "-DENABLE_TG=true",
            "-DGESTURE_AVAILABLE_PATH=\"" + _default_gesture_available_path + "\"",
            "-DGESTURE_ENABLE_PATH=\"" + _default_gesture_enable_path + "\"",
        ],
    }) + select(soong_config_variable("touch_lge", "enable_gm"), {
        "false": ["-DENABLE_GM=false"],
        "true": [
            "-DENABLE_GM=true",
            "-DGLOVE_MODE_PATH=\"$(soong_config_variable touch_lge glove_mode_path ?: _default_glove_mode_path)\"",
        ],
        default: [
            "-DENABLE_GM=true",
            "-DGLOVE_MODE_PATH=\"" + _default_glove_mode_path + "\"",
        ],
    }),

    srcs: [
        "GloveMode.cpp",
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}