cc_binary {
    name: "android.hardware.radio-service.lge",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["radio-lge.rc"],
    defaults: ["android.hardware.radio-library.aidl_deps"],
    srcs: [
        "service.cpp",
        "LgeRadioCompat.cpp",
        "LgeRadioIndication.cpp",
        "LgeRadioIndicationV2.cpp",
        "LgeRadioResponse.cpp",
        "RadioAdapter.cpp",
        "Qos.cpp",
        "QosTracker.cpp",
    ],
    // Reuse upstream conversions without copying them or changing their exports.
    include_dirs: ["hardware/interfaces/radio/aidl/compat/libradiocompat"],
    shared_libs: [
        "android.hardware.radio-library.compat",
        "android.hardware.radio.config@1.0",
        "android.hardware.radio.config@1.1",
        "android.hardware.radio.config@1.2",
        "android.hardware.radio.config@1.3",
        "android.hardware.radio@1.0",
        "android.hardware.radio@1.1",
        "android.hardware.radio@1.2",
        "android.hardware.radio@1.3",
        "android.hardware.radio@1.4",
        "android.hardware.radio@1.5",
        "android.hardware.radio@1.6",
        "vendor.lge.hardware.radio@2.0",
        "vendor.lge.hardware.lgdata@1.0",
        "android.hidl.safe_union@1.0",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhidlbase",
        "libutils",
    ],
    cflags: ["-Wall", "-Wextra", "-Wno-unused-parameter"],
}
